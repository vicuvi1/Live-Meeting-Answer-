# Configuration for Olivia Meeting Copilot
APP_NAME="Olivia Meeting Copilot"
DEBUG=true

# Personalized target name for meeting alerts and custom prompt
TARGET_NAME=Olivia
DEFAULT_LANGUAGE=ro

# Database connection string (defaults to local SQLite file in ./data)
DATABASE_URL=sqlite+aiosqlite:///./data/copilot.db

# API Keys (Optional: works offline with smart heuristic engine)
# 1. Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# 2. OpenRouter (Access to free & paid models like Gemini, Llama 3.3, DeepSeek at https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Default provider: "gemini" or "openrouter"
DEFAULT_PROVIDER=gemini
