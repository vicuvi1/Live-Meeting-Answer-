# Configuration for Olivia Meeting Copilot
APP_NAME="Olivia Meeting Copilot"
DEBUG=true

# Personalized target name for meeting alerts and custom prompt
TARGET_NAME=Olivia
DEFAULT_LANGUAGE=ro

# Database connection string (defaults to local SQLite file in ./data)
DATABASE_URL=sqlite+aiosqlite:///./data/copilot.db

# API Keys (Optional for local testing; smart heuristic fallback is included)
# Get your Gemini key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get your Deepgram key for real-time Romanian STT: https://deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Fast model selection
LLM_MODEL=gemini-2.5-flash
