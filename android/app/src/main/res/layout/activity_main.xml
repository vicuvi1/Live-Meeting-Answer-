<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olivia Copilot"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistent Discret Ședințe Live (Română)"
            android:textColor="@color/emerald_500"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Server & User Configuration Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card_dark"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Configurare Conexiune"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adresă Server (IP PC sau Cloud):"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/editServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#0F172A"
                    android:textColor="@color/text_white"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:hint="ex: http://192.168.1.100:8000"
                    android:textColorHint="#64748B"
                    android:inputType="textUri"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Numele persoanei asistate:"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/editTargetName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#0F172A"
                    android:textColor="@color/text_white"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:text="Olivia"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="🔌 Verifică Conexiunea"
                    android:textAllCaps="false"
                    android:backgroundTint="#334155"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Neverificat"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Xiaomi HyperOS Special Permissions Card (Auto-detected) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardXiaomiSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E1B4B"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Optimizare Xiaomi HyperOS (15T Pro)"
                    android:textColor="#A5B4FC"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pentru ca bula plutitoare să nu fie oprită de HyperOS în timpul apelului Zoom, apasă butoanele de mai jos:"
                    android:textColor="#C7D2FE"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btnXiaomiPopup"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="1. Permite 'Ferestre Pop-up în Fundal'"
                    android:textAllCaps="false"
                    android:backgroundTint="#4338CA"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnXiaomiBattery"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="2. Baterie: Alege 'Fără Restricții'"
                    android:textAllCaps="false"
                    android:backgroundTint="#4338CA"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnXiaomiAutostart"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="3. Permite 'Pornire Automată'"
                    android:textAllCaps="false"
                    android:backgroundTint="#4338CA"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- In-App GitHub Auto-Updater Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#064E3B"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔄 Actualizări Aplicație"
                        android:textColor="#A7F3D0"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txtCurrentVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.0"
                        android:textColor="#6EE7B7"
                        android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtUpdateStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verificare automată versiuni noi..."
                    android:textColor="#D1FAE5"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"/>

                <ProgressBar
                    android:id="@+id/progressUpdate"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:max="100"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btnCheckOrUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔍 Verifică Actualizări GitHub"
                    android:textAllCaps="false"
                    android:backgroundTint="#059669"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Instructions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card_dark"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instrucțiuni de Utilizare:"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Apeși butonul verde de mai jos pentru a lansa bula.\n2. Deschizi Zoom sau Google Meet și participi normal (doar o singură Olivia apare în apel!).\n3. Bula vibrează și luminează în galben când ești întrebată ceva.\n4. O atingi și ai instant cele 3 răspunsuri: Da, Scuză Mute, sau Prudență."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dual Launch Buttons for Mom -->
        <Button
            android:id="@+id/btnOpenFullscreen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📱 Deschide pe Tot Ecranul (Recomandat)"
            android:textAllCaps="false"
            android:backgroundTint="#047857"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🫧 Lansează Bula Plutitoare (Peste Zoom)"
            android:textAllCaps="false"
            android:backgroundTint="#1E293B"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
