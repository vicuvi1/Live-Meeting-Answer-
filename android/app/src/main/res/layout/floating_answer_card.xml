<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#0F172A"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Răspunsuri Asistent Olivia"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnCloseCard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:text="✕"
                android:textColor="#94A3B8"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:textStyle="bold"
                android:textSize="16sp" />
        </RelativeLayout>

        <!-- Live Subtitle Context -->
        <TextView
            android:id="@+id/txtLiveCaptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Se ascultă conversația din ședință..."
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:italic="true"
            android:maxLines="2"
            android:ellipsize="end"
            android:background="#1E293B"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- 3 Tactical Mode Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnTacticalAgree"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🟢 Da / Acord"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="3dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnTacticalStall"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🟡 Mute (15s)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#B45309"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="3dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnTacticalCaution"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔴 Prudență"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#BE123C"
                android:textColor="#FFFFFF"
                android:padding="0dp" />
        </LinearLayout>

        <!-- The Spoken Words Card (Large text for Mom) -->
        <LinearLayout
            android:id="@+id/responseBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtResponseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢 SPUNE CU VOCE TARE:"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtSpokenResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sunt complet de acord cu propunerea și putem continua."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Actions: Copy & Listen in Earphone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnCopyResponse"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="📋 Copiază"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSpeakResponse"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="🎧 Ascultă în Cască"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#0F766E"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Dismiss Button -->
        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Am Răspuns (Închide)"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
